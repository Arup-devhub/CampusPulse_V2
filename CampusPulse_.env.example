# CampusPulse environment template
# Copy to .env and replace every placeholder. Never commit .env.

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=campuspulse


# -------------------------------------------------------------------
# Authentication
# -------------------------------------------------------------------
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------------
# CORS / security
# -------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -------------------------------------------------------------------
# Async jobs / cache
# Architecture specifies Redis for queue/cache.
# -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
JOB_CONCURRENCY=4

# -------------------------------------------------------------------
# Object/file storage
# Architecture requires external/object storage for uploaded files
# and evidence; exact provider is intentionally provider-neutral.
# -------------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=<s3-compatible-provider>
OBJECT_STORAGE_BUCKET=<bucket-name>
OBJECT_STORAGE_REGION=<region>
OBJECT_STORAGE_ENDPOINT=<optional-endpoint>
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>

# -------------------------------------------------------------------
# Email
# -------------------------------------------------------------------
EMAIL_PROVIDER=<smtp-or-supported-provider>
EMAIL_FROM=no-reply@example.com
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_SECURE=false

# -------------------------------------------------------------------
# AI Gateway
# Provider-neutral by design. Configure only providers actually used.
# -------------------------------------------------------------------
LLM_PROVIDER=<provider-name>
LLM_API_KEY=<provider-api-key>
LLM_MODEL=<model-name>
LLM_BASE_URL=<optional-provider-base-url>
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Speech-to-text for AI interview, if enabled
STT_PROVIDER=<provider-name>
STT_API_KEY=<provider-api-key>
STT_MODEL=<model-name>

# Computer vision / proctoring service, if enabled
CV_PROVIDER=<provider-name>
CV_API_KEY=<provider-api-key>
CV_BASE_URL=<provider-base-url>
CV_TIMEOUT_MS=10000

# Optional Python ML service. Node remains the primary API layer.
PYTHON_ML_ENABLED=false
PYTHON_ML_BASE_URL=http://localhost:8000
PYTHON_ML_SERVICE_TOKEN=<service-token>

# -------------------------------------------------------------------
# Observability / audit
# -------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# -------------------------------------------------------------------
# Frontend build-time variables (Vite)
# Put these in the frontend's .env when using Vite.
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
